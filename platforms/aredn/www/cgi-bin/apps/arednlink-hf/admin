#!/bin/sh
# Sidebar-discovery anchor and fail-closed fallback. When the uhttpd ucode_prefix
# mapping to /app/arednlink-hf-entry.ut is present, uhttpd dispatches this URL to
# the ucode entry and this file is never executed. Without the mapping, an admin
# filename does not authenticate an HTTP caller, so refuse.
printf 'Status: 503 Service Unavailable\r\nContent-Type: text/plain; charset=utf-8\r\nCache-Control: no-store\r\nX-Content-Type-Options: nosniff\r\n\r\nNative UI is not enabled on this node.\n'
