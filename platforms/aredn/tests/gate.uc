// Synthetic values only. Run inside the prescribed isolated build container.
import * as gate from '../app/arednlink-hf/gate.uc';
function check(condition, name) {
    if (!condition) die(name);
    print(name, ': passed\n');
};
const env = {REQUEST_URI: '/cgi-bin/apps/arednlink-hf/admin', REQUEST_METHOD: 'GET', headers: {}};
check(gate.preflight(env) === null, 'GET preflight');
env.REQUEST_URI = '/cgi-bin/apps/arednlink-hf/admin/extra';
check(gate.preflight(env) === '404 Not Found', 'direct suffix rejected');
env.REQUEST_URI = '/cgi-bin/apps/arednlink-hf/admin';
env.REQUEST_METHOD = 'POST';
env.CONTENT_TYPE = 'application/x-www-form-urlencoded';
check(gate.preflight(env) === '415 Unsupported Media Type', 'native unbounded form parser bypass refused');
env.CONTENT_TYPE = 'text/plain;charset=UTF-8';
env.CONTENT_LENGTH = '65537';
check(gate.preflight(env) === '413 Payload Too Large', 'oversized body rejected');
env.CONTENT_LENGTH = '0';
env.HTTP_HOST = 'example.local.mesh:8080';
const token = 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa';
env.headers = {origin: 'http://foreign.invalid', cookie: `arednlinkCSRF=${token}`, 'x-arednlink-csrf': token};
check(!gate.csrf(env), 'cross-site POST refused');
env.headers.origin = 'http://example.local.mesh:8080';
check(gate.csrf(env), 'same-origin CSRF accepted');
env.headers['sec-fetch-site'] = 'cross-site';
check(!gate.csrf(env), 'cross-site browser metadata refused');
delete env.headers['sec-fetch-site'];
delete env.headers.cookie;
check(!gate.csrf(env), 'missing CSRF cookie refused');
env.headers.cookie = `arednlinkCSRF=${token}; arednlinkCSRF=${token}`;
check(!gate.csrf(env), 'duplicate CSRF cookies refused');
env.headers.cookie = `arednlinkCSRF=${token}`;
env.HTTP_HOST = '[2001:db8::1]:8080';
env.headers.origin = 'http://[2001:db8::1]:8080';
check(gate.csrf(env), 'bracketed IPv6 same-origin accepted');
env.headers['transfer-encoding'] = 'chunked';
check(gate.preflight(env) === '400 Bad Request', 'transfer encoding refused');
delete env.headers['transfer-encoding'];
env.CONTENT_LENGTH = '0001';
check(gate.preflight(env) === '413 Payload Too Large', 'noncanonical body length refused');
