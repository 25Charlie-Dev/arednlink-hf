#!/bin/sh /etc/rc.common
# Staging template: installing this file does not enable or start the service.
USE_PROCD=1
START=95
STOP=10

start_service() {
    [ -r /etc/arednlink-hf/config.json ] || return 1
    [ -x /usr/sbin/arednlink-hf ] || return 1
    [ ! -L /tmp/run/arednlink-hf ] || return 1
    mkdir -p /tmp/run/arednlink-hf || return 1
    chown nobody:nogroup /tmp/run/arednlink-hf || return 1
    chmod 0700 /tmp/run/arednlink-hf || return 1
    procd_open_instance
    procd_set_param command /usr/sbin/arednlink-hf -config /etc/arednlink-hf/config.json
    procd_set_param user nobody
    procd_set_param group nogroup
    procd_set_param env GOMEMLIMIT=16MiB GOMAXPROCS=1
    procd_set_param nice 10
    procd_set_param respawn 3600 5 5
    procd_set_param term_timeout 10
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
